#!/bin/sh
set -eu

if [ "${RENEWED_LINEAGE:-}" != "/etc/letsencrypt/live/codio.dev" ]; then
    exit 0
fi

cert_dir=/etc/vpn-certs/codio
mkdir -p "$cert_dir"
chown root:vpn-cert "$cert_dir"
chmod 0750 "$cert_dir"
install -o root -g vpn-cert -m 0640 "$RENEWED_LINEAGE/fullchain.pem" "$cert_dir/fullchain.pem"
install -o root -g vpn-cert -m 0640 "$RENEWED_LINEAGE/privkey.pem" "$cert_dir/privkey.pem"
/usr/local/bin/xray run -test -config /etc/xray/config.json
systemctl restart xray
